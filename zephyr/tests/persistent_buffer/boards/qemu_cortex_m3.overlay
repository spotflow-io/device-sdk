/* Simulated flash with 8-byte write blocks (the largest FCB supports) and small sectors, so that
 * tests wrap the ring quickly.
 */
/ {
	sim_flash_controller: sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x00000000 0x2000>;
			erase-block-size = <1024>;
			write-block-size = <8>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				spotflow_buffer_partition: partition@0 {
					label = "spotflow-buffer";
					reg = <0x00000000 0x2000>;
				};
			};
		};
	};
};
