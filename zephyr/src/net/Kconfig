choice SPOTFLOW_TRANSPORT
	prompt "Spotflow transport"
	default SPOTFLOW_TRANSPORT_MQTT

rsource "Kconfig.mqtt"
rsource "Kconfig.ble"

endchoice

config SPOTFLOW_INGEST_KEY_DYNAMIC
	bool "Provide the ingest key from application code"
	help
		Obtain the ingest key at runtime by implementing
		const char* spotflow_on_ingest_key_requested(void) in your application.
		A NULL result delays the MQTT connection or BLE advertising and is retried.
		The first non-NULL result is cached until reboot.
		BLE defaults to requiring link encryption. Enable BT_SMP to use it.

config SPOTFLOW_INGEST_KEY
	string "Spotflow ingest key"
	depends on !SPOTFLOW_INGEST_KEY_DYNAMIC
	help
		The ingest key authenticates the device with Spotflow. Manage ingest
		keys in the Spotflow portal.

		Direct MQTT requires a nonempty key. For BLE, leave this empty if the
		gateway provides the key. A nonempty BLE key is exposed over GATT.
		BLE defaults to requiring link encryption. Enable BT_SMP to use it.

		To provide the key at runtime, enable SPOTFLOW_INGEST_KEY_DYNAMIC
		and implement spotflow_on_ingest_key_requested().

config SPOTFLOW_BLE_HAS_INGEST_KEY
	def_bool SPOTFLOW_INGEST_KEY_DYNAMIC || SPOTFLOW_INGEST_KEY != ""
	depends on SPOTFLOW_TRANSPORT_BLE
