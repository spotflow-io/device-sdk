/* Use the same factory layout for Wi-Fi and BLE OTA images. */
#include "../../ota_psa/boards/lp_em_cc35x1_cc3551e.overlay"

&storage_partition {
	reg = <0x8000 0x8000>;
};

&flash2 {
	partitions {
		coredump_partition: partition@10000 {
			label = "coredump-partition";
			reg = <0x10000 0x12000>;
		};
	};
};
