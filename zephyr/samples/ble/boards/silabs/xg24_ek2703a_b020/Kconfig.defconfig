if BOARD_XG24_EK2703A_B020

configdefault LOG_BACKEND_SWO_FREQ_HZ
	default 875000

config CMU_HFXO_FREQ
	default 39000000

config CMU_LFXO_FREQ
	default 32768

if SOC_GECKO_USE_RAIL

config FPU
	default y

endif # SOC_GECKO_USE_RAIL

if SPOTFLOW_COREDUMPS

choice DEBUG_COREDUMP_BACKEND
	default DEBUG_COREDUMP_BACKEND_IN_MEMORY
endchoice

config DEBUG_COREDUMP_BACKEND_IN_MEMORY_SIZE
	default 32768

endif # SPOTFLOW_COREDUMPS

endif # BOARD_XG24_EK2703A_B020
