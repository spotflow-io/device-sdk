/* Add the button definition missing from older Zephyr versions. */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		sw0 = &user_button_0;
	};

	gpio_keys {
		compatible = "gpio-keys";
		user_button_0: button_0 {
			label = "User SW2";
			gpios = <&hsgpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
			status = "okay";
		};
	};
};

/* Reserve the final MiB of external flash for coredumps. */
&w25q512jvfiq {
	partitions {
		storage_partition: partition@620000 {
			label = "storage";
			reg = <0x00620000 (DT_SIZE_M(57) - DT_SIZE_K(128))>;
		};

		coredump_partition: partition@3f00000 {
			label = "coredump-partition";
			reg = <0x03f00000 DT_SIZE_M(1)>;
		};
	};
};
