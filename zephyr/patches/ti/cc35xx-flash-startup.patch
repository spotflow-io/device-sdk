+/*
+ * Restore XIP before returning to callers in external flash, including when
+ * a command fails before its normal exit sequence. Preserve the command error
+ * after attempting both controller restoration and OTFDE re-enablement.
+ */
+static FlashStigStatus __attribute__((section(".TI.ramfunc")))
+FlashStigFinishOperation(uint8_t DeviceNum, FlashStigStatus operationStatus)
+{
+    FlashStigStatus restoreStatus;
+
+    if (operationStatus != FLASH_STATUS_SUCCESS)
+    {
+        FlashStigConfigOp(FLASH_STIG_CONFIG_EXIT);
+    }
+
+    restoreStatus = FlashStigPostConfigOp(DeviceNum);
+
+    return operationStatus != FLASH_STATUS_SUCCESS ? operationStatus : restoreStatus;
+}
