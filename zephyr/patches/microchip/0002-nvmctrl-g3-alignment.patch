Subject: Require aligned destinations for NVMCTRL G3 row and quad-double-word writes

Base: 303ef231d24120af736bbf0ac8ebab72488ad3c6
Repository: https://github.com/Zephyr4Microchip/microchip-zephyr

diff --git a/drivers/flash/flash_mchp_nvmctrl_g3.c b/drivers/flash/flash_mchp_nvmctrl_g3.c
--- a/drivers/flash/flash_mchp_nvmctrl_g3.c
+++ b/drivers/flash/flash_mchp_nvmctrl_g3.c
@@ -391,7 +391,8 @@
 		fcw_ready_wait(regs);
 		LOG_DBG("Number of bytes yet to be written %u", no_of_bytes);
 
